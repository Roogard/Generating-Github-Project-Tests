# Copy this file to .env and fill in your values.

# --- LLM Provider ---
# Set the provider and its API key. Only the key for your chosen provider is needed.
# Provider options: deepseek, openai, anthropic, ollama
# Can also be set via ghtest.toml or --provider CLI flag.

DEEPSEEK_API_KEY=sk-...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Model name (overrides ghtest.toml default for your provider)
LLM_MODEL=deepseek-chat

# Provider (if not set, defaults to deepseek)
# LLM_PROVIDER=deepseek

# Custom base URL (if not set, auto-detected from provider)
# LLM_BASE_URL=https://api.deepseek.com
