# Copy this file to .env and fill in at least one API key.
#   cp .env.example .env

# --- LLM Provider ---
# Which provider to use (deepseek | anthropic | openai | ollama)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# Fill in the key for your chosen provider. Others can be left blank.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Ollama runs locally — no key needed, just set LLM_PROVIDER=ollama
